USE_HTTPS=false

# ========== Configurações de Emergência & Segurança ==========
# Se true, permite ignorar falhas graves para manter o controle (CUIDADO!)
EMERGENCY_MODE=true
# Ativa verificação estrita de hosts (Proteção contra Man-in-the-Middle)
SSH_STRICT_HOST_CHECKING=false
# Limite de falhas de autenticação antes de disparar alerta de invasão
MAX_AUTH_FAILURES=3
# Limite de uso de CPU para disparar alerta de carga alta (%)
CPU_ALERT_THRESHOLD=80

# ========== Watchdog & Auto-Remediação (Por Servidor) ==========
# Documente aqui as vars do `.env` de cada agente remoto.
# (Estes valores configuram o comportement do agente lá no VPS)

# Servidor 1: Host Genix
WATCHDOG_SERVER_ID_1=host-genix
WATCHDOG_SERVER_ROLE_1=wordpress

# Servidor 2: HOST Viral
WATCHDOG_SERVER_ID_2=host-viral
WATCHDOG_SERVER_ROLE_2=wordpress

# Servidor 3: Host WINUP
WATCHDOG_SERVER_ID_3=host-winup
WATCHDOG_SERVER_ROLE_3=wordpress-python

# Servidor 4: WINUP
WATCHDOG_SERVER_ID_4=winup
WATCHDOG_SERVER_ROLE_4=python-nextjs

# Valores globais recomendados (mesmos em todos os servidores)
WATCHDOG_INTERVAL_SECS=30
WATCHDOG_MAX_FAILURES=3
WATCHDOG_COOLDOWN_SECS=300DASHBOARD_NOC_TOKEN=8a7d92d18e78461bb274215ad81fbfbb


